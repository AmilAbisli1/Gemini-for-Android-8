rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny all reads and writes by default.
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidPersonaId(personaId) {
      return personaId in ['general', 'reasoning', 'vision', 'coding', 'fast'];
    }

    function isValidModelName(modelName) {
      return modelName in ['gemini-3.8-flash', 'gemini-4-argon', 'gemini-3.5-flash-lite'];
    }

    function isValidConversation(data, userId) {
      return data.userId is string &&
             data.userId == userId &&
             data.title is string &&
             data.title.size() >= 1 &&
             data.title.size() <= 120 &&
             data.personaId is string &&
             isValidPersonaId(data.personaId) &&
             data.modelName is string &&
             isValidModelName(data.modelName) &&
             data.lastMessagePreview is string &&
             data.lastMessagePreview.size() <= 300 &&
             data.messageCount is int &&
             data.messageCount >= 0 &&
             data.messageCount <= 10000 &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isValidMessage(data, userId, conversationId) {
      return data.userId is string &&
             data.userId == userId &&
             data.conversationId is string &&
             data.conversationId == conversationId &&
             data.role is string &&
             data.role in ['user', 'model'] &&
             data.text is string &&
             data.text.size() <= 32000 &&
             data.hasImage is bool &&
             (!('localImagePath' in data) || (data.localImagePath is string && data.localImagePath.size() <= 500)) &&
             (!('modelUsed' in data) || (data.modelUsed is string && data.modelUsed.size() <= 80)) &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time;
    }

    match /users/{userId}/conversations/{conversationId} {
      allow get: if isOwner(userId) && isValidId(conversationId);
      allow list: if isOwner(userId);

      allow create: if isOwner(userId) &&
                       isValidId(conversationId) &&
                       incoming().keys().hasAll(['userId', 'title', 'personaId', 'modelName', 'lastMessagePreview', 'messageCount', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'title', 'personaId', 'modelName', 'lastMessagePreview', 'messageCount', 'createdAt', 'updatedAt']) &&
                       isValidConversation(incoming(), userId);

      allow update: if isOwner(userId) &&
                       isValidId(conversationId) &&
                       isValidConversation(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['title', 'personaId', 'modelName', 'lastMessagePreview', 'messageCount', 'updatedAt']);

      allow delete: if isOwner(userId) && isValidId(conversationId);

      match /messages/{messageId} {
        allow get: if isOwner(userId) && isValidId(conversationId) && isValidId(messageId);
        allow list: if isOwner(userId) && isValidId(conversationId);

        allow create: if isOwner(userId) &&
                         isValidId(conversationId) &&
                         isValidId(messageId) &&
                         incoming().keys().hasAll(['userId', 'conversationId', 'role', 'text', 'hasImage', 'createdAt']) &&
                         incoming().keys().hasOnly(['userId', 'conversationId', 'role', 'text', 'hasImage', 'localImagePath', 'modelUsed', 'createdAt']) &&
                         isValidMessage(incoming(), userId, conversationId) &&
                         existsAfter(/databases/$(database)/documents/users/$(userId)/conversations/$(conversationId));

        allow update: if false;
        allow delete: if isOwner(userId) && isValidId(conversationId) && isValidId(messageId);
      }
    }
  }
}
